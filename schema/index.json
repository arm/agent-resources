{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arm/agent-resources/schema/index.json",
  "title": "Arm Agent Resources registry index (context-first)",
  "type": "object",
  "required": ["contexts"],
  "additionalProperties": false,
  "properties": {
    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/context" }
    }
  },
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "description", "count"],
      "properties": {
        "key": {
          "type": "string",
          "enum": [
            "cloud-development",
            "compiled-languages",
            "mobile-games",
            "ml-developer",
            "embedded-development",
            "performance-optimization"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "pattern": "^registry/[a-z-]+\\.yaml$" },
        "count": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "count": { "minimum": 1 } }
          },
          "then": { "required": ["file"] }
        }
      ]
    }
  }
}
