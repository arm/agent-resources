{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arm/agent-resources/schema/index.json",
  "title": "Arm Agent Resources registry index",
  "type": "object",
  "required": ["categories"],
  "additionalProperties": false,
  "properties": {
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/category" }
    }
  },
  "$defs": {
    "category": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "title", "description", "count"],
      "properties": {
        "key": {
          "type": "string",
          "enum": [
            "mcp-servers",
            "knowledge-bases",
            "learning-paths",
            "profiling-optimization",
            "sdks-tools",
            "reference-implementations"
          ]
        },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "pattern": "^registry/[a-z-]+\\.yaml$" },
        "count": { "type": "integer", "minimum": 0 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "count": { "minimum": 1 } }
          },
          "then": { "required": ["file"] }
        }
      ]
    }
  }
}
