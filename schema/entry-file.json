{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/arm/agent-resources/schema/entry-file.json",
  "title": "Arm Agent Resources context file",
  "type": "object",
  "required": ["resources"],
  "additionalProperties": false,
  "properties": {
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/resource" }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "category", "when_to_use", "example_use_case"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://",
          "description": "Public https link. A tool may be public even when its source repo is not -- point at the public product page or docs."
        },
        "category": {
          "type": "string",
          "enum": [
            "mcp-servers",
            "knowledge-bases",
            "learning-paths",
            "profiling-optimization",
            "sdks-tools",
            "reference-implementations"
          ]
        },
        "when_to_use": { "type": "string", "minLength": 1 },
        "example_use_case": { "type": "string", "minLength": 1 }
      }
    }
  }
}
